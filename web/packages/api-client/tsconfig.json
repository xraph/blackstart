{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],

    // `noUncheckedIndexedAccess` stays off for the generated sources: indexing
    // a lookup table it just built is not a case worth guarding, and the check
    // exists for code a person writes. Everything else — including
    // exactOptionalPropertyTypes — the generator now satisfies, which is where
    // it belongs. A relaxation here would only have hidden the fact that the
    // output could not be consumed by a strict project at all.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"]
}
