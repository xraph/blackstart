# Exact versions, never ranges.
#
# The viewer depends on the @takram/three-* packages, which are marked
# Alpha/Beta and are mid-way through a WebGPU rewrite. A caret range on those
# would let a breaking change arrive silently on a fresh install. The same
# reasoning applies broadly enough that it is simpler to make it the default
# for every dependency than to remember which ones are volatile.
save-exact=true

# Fail rather than silently resolving a lockfile that disagrees with
# package.json. CI relies on this; making it the local default too means the
# two behave identically.
strict-peer-dependencies=false
resolution-mode=highest
