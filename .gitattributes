# Normalize line endings across platforms.
* text=auto eol=lf

# Binary and data formats git should not try to diff or merge.
*.png    binary
*.jpg    binary
*.ico    binary
*.pdf    binary
*.grib2  binary
*.zarr   binary

# ---------------------------------------------------------------------------
# Generated, vendored, and fixture paths.
#
# This block is the single source of truth for "not hand-written code". The
# commit-size check in scripts/check-commit-size.sh reads it via
# `git check-attr linguist-generated` rather than keeping its own glob list,
# so the two cannot drift apart. Anything marked here is excluded from the
# ~500-line-per-commit limit and from reported language statistics.
#
# Adding a path here is a deliberate act. If it is hand-written, it does not
# belong in this block.
# ---------------------------------------------------------------------------

# Protobuf stubs — generated by `buf generate`, committed so consumers of the
# Go module do not need the protobuf toolchain.
proto/gen/**            linguist-generated=true -diff
*.pb.go                 linguist-generated=true -diff
*_grpc.pb.go            linguist-generated=true -diff

# Public test cases, golden files, and sample documents. Downloaded or
# machine-produced; provenance lives in the adjacent SOURCES.md.
data/**                 linguist-generated=true -diff

# The platform API client, produced by `forge client generate` from the host's
# own OpenAPI document. Committed so the viewer builds without a running
# server, and marked generated so it does not inflate the hand-written line
# count this project treats as a deliverable. The wrapper beside it in
# src/index.ts is hand-written and deliberately not covered by this rule.
web/packages/api-client/src/generated/** linguist-generated=true -diff

# Package-local golden files, produced by `go test -update`. Marked by
# extension rather than by directory: a testdata/ directory also holds
# hand-authored fixtures — a small SCD written from the schema, a MATPOWER
# case trimmed by hand — and those are hand-written work that should count.
**/*.golden             linguist-generated=true

# Dependency lockfiles.
go.sum                  linguist-generated=true -diff
rust/Cargo.lock         linguist-generated=true -diff
web/pnpm-lock.yaml      linguist-generated=true -diff

# Vendored third-party source, if it ever becomes necessary.
third_party/**          linguist-vendored=true -diff

# Governing design documents, committed verbatim as project inputs. Prose, not
# hand-written code, and not authored commit-by-commit — so the per-commit
# size limit does not apply to them. Documentation written as part of the work
# (README, CONTRIBUTING, a private design note, docs/extensions) is NOT marked here and does
# count, because it is authored alongside the code it describes.
a private design note          linguist-documentation=true
