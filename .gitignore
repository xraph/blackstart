/bin/
/dist/
*.exe
*.dll
*.so
*.dylib

# ---- Go --------------------------------------------------------------------
*.test
*.out
coverage.out
coverage.html
go.work.sum
/vendor/

# ---- Rust ------------------------------------------------------------------
/rust/target/
**/*.rs.bk

# ---- Node / web ------------------------------------------------------------
node_modules/
.pnpm-store/
/web/**/dist/
/web/**/.vite/
*.tsbuildinfo

# ---- Python (offline golden-file generator only) ---------------------------
__pycache__/
*.py[cod]
/tools/goldengen/.venv/

# ---- Local configuration and secrets ---------------------------------------
# Blackstart uses only public data, but database credentials are still secrets.
.env
.env.local
.env.*.local
config.local.yaml
config.local.yml
.forge.local.yaml

# ---- Large downloaded datasets ---------------------------------------------
# Test cases and sample files are committed (they are small and their hashes
# are the point). Bulk weather and outage archives are not — they are fetched
# on demand and catalogued by content hash.
/data/weather/
/data/archive/
*.grib2
*.zarr/

# The decoder's own fixtures are the exception, and a narrow one. A GRIB2
# decoder cannot be tested against anything but real messages, and these are
# byte-ranged out of published files — hundreds of bytes to tens of kilobytes,
# not the 151 MB products they came from. Their provenance is recorded beside
# them.
!rust/bs-grib/tests/fixtures/*.grib2

# ---- Editors and OS --------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Local configuration ---------------------------------------------------
# The base config.yaml is committed and carries nothing secret; the local
# layer carries connection strings and stays out of the repository.
config.local.yaml
config.local.yml
configs/config.local.yaml
configs/config.local.yml

# ---- Agent and tooling scratch ---------------------------------------------
.claude/

# The forge CLI's local state directory: build caches and dev-server bookkeeping,
# regenerated on demand and specific to one machine.
.forge/

# The content-addressable byte plane's local driver root. Canonical encodings
# are rebuildable from their source cases by re-importing — the content hash is
# what makes that safe — so the bytes themselves are not repository content.
.data/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# Per-plan working state, reconstructible from git history.
.superpowers/
